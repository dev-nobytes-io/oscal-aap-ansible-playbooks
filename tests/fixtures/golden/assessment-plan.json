        {
          "uuid": "00e34067-5d42-5928-a4e3-0a898d3b43a1",
          "title": "Internet Explorer 11 is disabled or removed",
          "description": "The control is a binary state and both halves are directly observable: whether the optional feature is present, and whether policy disables the IE11 application. The one residual gap is IE mode inside Microsoft Edge, which is a deliberately supported configuration and is reported in the facts rather than judged, since the control speaks to Internet Explorer 11 as a browser rather than to the MSHTML engine.",
          "props": [
            {
              "name": "check-id",
              "value": "win-ie11-disabled",
              "ns": "https://nobytes.io/ns/oscal/cca/1.0"
            },
            {
