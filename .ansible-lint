---
# `production` is the strictest ansible-lint profile and the bar for Ansible
# Automation Platform certified content. A repository that asserts other
# people's compliance should be able to meet a published standard itself.
profile: production

# ansible-lint runs `ansible-galaxy collection install` implicitly on every
# invocation unless told not to. That made linting depend on galaxy.ansible.com
# being reachable -- it went down mid-run and turned main red for a transient
# network fault with no code change behind it. Worse, it is the wrong posture
# for a project whose thesis is air-gapped reproducibility. Dependencies are
# installed once, deliberately, by `make deps`; lint only reads what is there.
offline: true

exclude_paths:
  - .github/
  - .venv/
  - collections/ansible_collections/  # third-party; not ours to lint
  - oscal/upstream/                   # vendored Commonwealth data; never modified
  - tests/fixtures/

# Enforced beyond the profile default.
enable_list:
  - args
  - empty-string-compare
  - no-log-password
  - no-same-owner

# Warnings we accept but do not fail on yet.
warn_list:
  - experimental

kinds:
  - playbook: "playbooks/*.yml"
  - tasks: "collections/ansible_collections/nobytes/compliance/roles/*/tasks/*.yml"
  - vars: "inventory/group_vars/*.yml"
